# Copy to .env (git-ignored) and fill in your sandbox credentials, then run:
#   npm run test:integration

# Required: private API key (api_...) and the base URL of your sandbox gateway.
GATEWAY_API_KEY=api_your_sandbox_key
GATEWAY_BASE_URL=https://sandbox.your-gateway.com

# Optional: partner API key to exercise the partner endpoints (fraud rules, merchant boarding).
# GATEWAY_PARTNER_API_KEY=api_your_partner_key
# Optional: fee schedule id required to board a merchant in the partner tests.
# GATEWAY_FEE_SCHEDULE_ID=
# Optional: an existing sandbox terminal id to test terminal settlement.
# GATEWAY_TERMINAL_ID=
# Optional: an existing webhook id (partner key required) to test the webhook probe endpoint.
# GATEWAY_WEBHOOK_ID=
# Optional: allow a plain http:// base URL (local mocks only).
# GATEWAY_ALLOW_INSECURE_BASE_URL=false
